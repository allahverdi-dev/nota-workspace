# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# Logs and temp files
*.log
npm-debug.log*
yarn-error.log*
.cache/
tmp/
temp/

# Dependencies and build output
# (Nota ships no build step; these exist so tooling added later stays out.)
node_modules/
dist/
build/
.parcel-cache/

# Environment and secrets
# Nota needs none of these — it has no server and no API keys.
# Listed so a stray file can never be committed by accident.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Local user data exported from the app
nota-backup-*.json

# Claude Code / editor tooling
.claude/
